@using System.Globalization
@model string
@* Pemilih bahasa: Indonesia <-> English. Model adalah class tombol. *@
@{
    var english = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    var nextCulture = english ? "id" : "en";
    var nextLabel = english ? "Indonesia" : "English";
}
<form asp-controller="Language" asp-action="Set" method="post" class="lang-switch">
    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
    <button type="submit" name="culture" value="@nextCulture" class="@Model" lang="@nextCulture"
            aria-label="@T["language.switch"]" title="@T["language.switch"]">@nextLabel</button>
</form>
