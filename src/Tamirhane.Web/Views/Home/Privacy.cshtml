@using System.Globalization
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = T["legal.privacy.title"];
    ViewData["Description"] = T["seo.privacy.description"].Value;
    // Teks hukum panjang: Bahasa Indonesia default, Inggris tersedia di /en.
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "id";
}

<article class="legal">
    <h1>@T["legal.privacy.title"]</h1>
    <p class="muted">@T["legal.updated"]</p>
    <partial name="@($"~/Views/Home/Legal/_Privacy.{lang}.cshtml")" />
</article>
