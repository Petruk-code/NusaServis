@using System.Globalization
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = T["legal.terms.title"];
    ViewData["Description"] = T["seo.terms.description"].Value;
    // Teks hukum panjang: Bahasa Indonesia default, Inggris tersedia di /en.
    var lang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "en" : "id";
}

<article class="legal">
    <h1>@T["legal.terms.title"]</h1>
    <p class="muted">@T["legal.updated"]</p>
    <partial name="@($"~/Views/Home/Legal/_Terms.{lang}.cshtml")" />
</article>
